# Only touch a factory-fresh router.
[ "$(uci -q get qol_config.state.applied)" = "1" ] && exit 0
touch /etc/config/qol_config

uci -q batch << EOI

# Firewall settings
set firewall.@zone[1].input='DROP'
set firewall.@zone[1].forward='DROP'

# uHTTPd settings
set uhttpd.main.redirect_https='1'

# Mark these defaults as applied
set qol_config.state='state'
set qol_config.state.applied='1'

commit firewall
commit uhttpd
commit qol_config
EOI
